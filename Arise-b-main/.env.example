# ARISE environment template
# Local-development defaults only; production needs real deployment URLs.

# Convex client URL
VITE_CONVEX_URL=http://127.0.0.1:3210

# Convex HTTP Actions/site origin — not the frontend URL
CONVEX_SITE_URL=http://127.0.0.1:3211

# Frontend URL for local development
SITE_URL=http://localhost:5173

# Optional: normally selected by the Convex CLI
# CONVEX_DEPLOYMENT=

# Keep API keys and passwords out of this file.
# Configure any required secrets securely in your deployment environment.
